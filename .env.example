# Azure OpenAI configuration. The key stays empty here.
# Chat deployment cia-chat is gpt-4o 2024-11-20. API version is the GA pin.
# Retrieval does not call cia-embed. See docs/09-model-deployment.md.
AZURE_OPENAI_ENDPOINT=https://consulting-agent-system.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=cia-chat
AZURE_OPENAI_API_VERSION=2024-10-21

# Database
# Relative to the working directory. The initializer reads process environment,
# not this file or .env automatically. See docs/09-database.md.
DATABASE_URL=sqlite:///consulting_intelligence.db

# Local review API: set in the process environment, enter the same token in Reviewer access.
REVIEWER_TOKEN=
USE_FIXTURES=false
